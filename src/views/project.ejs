<%- include('partials/header') %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <p>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' })
                %>
        </p>
        
        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>
        
        <p>
            <strong>Organization:</strong>
            <a href="/organizations/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>


        <!-- CATEGORIES GO HERE -->

        <h2>Categories</h2>
        
        <div class="category-list">
            <% categories.forEach(category=> { %>
                <a class="category-tag" href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
                <% }) %>
        </div>
        
        <h2>Actions</h2>
        
        <div class="project-actions">
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
            <a href="/assign-categories/<%= project.project_id %>">Assign Categories</a>
        </div>
    </main>

    <%- include('partials/footer') %>