<%- include('partials/header') %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <p>
            <%= project.description %>
        </p>

        <p>
            Date:
            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                day: 'numeric' }) %>
        </p>

        <p>
            Location:
            <%= project.location %>
        </p>

        <p>
            Organization:
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>


        <!-- CATEGORIES GO HERE -->

        <h2>Categories</h2>

        <div>
            <% categories.forEach(category=> { %>

                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>

                <% }) %>
        </div>

        <a href="/edit-project/<%= project.project_id %>">
            Edit Project
        </a>
    </main>

    <%- include('partials/footer') %>